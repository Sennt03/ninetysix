// Prisma se usa cuando DATABASE_TYPE = mysql | postgres.
// Para MongoDB se usa Mongoose (ver src/modules/users/schemas).
//
// El catálogo (productos/categorías) es relacional puro y solo se activa con
// una BD SQL (ver isSql() en AppModule).

generator client {
  provider = "prisma-client-js"
  // Library engine (por defecto): corre DENTRO del proceso Node, sin lanzar un
  // proceso aparte (en Hostinger/CloudLinux el binary engine daba "spawn EAGAIN"
  // por el límite de procesos). El panic "timer has gone away" se evita
  // limitando los hilos del motor con TOKIO_WORKER_THREADS=2 (var de entorno).
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
//  USUARIOS / AUTH
//  En MySQL no existen arrays de enum: los roles se guardan como JSON string
//  (p. ej. ["ADMIN"]). El mapeo a Role[] del dominio vive en
//  user.prisma.repository.ts.
// ===========================================================================
model User {
  id               String   @id @default(uuid())
  email            String   @unique
  username         String
  password         String
  roles            String   @default("[\"USER\"]")
  refreshTokenHash String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("users")
}

// ===========================================================================
//  CATÁLOGO
// ===========================================================================
enum ProductStatus {
  draft
  active
  archived
}

enum CategoryStatus {
  active
  inactive
}

enum StockPolicy {
  deny
  allow
}

model Category {
  id              String         @id @default(uuid())
  name            String         @db.VarChar(255)
  slug            String         @unique @db.VarChar(255)
  description     String?        @db.Text
  parentId        String?
  parent          Category?      @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]     @relation("CategoryTree")
  imageAssetId    String?
  imageAsset      MediaAsset?    @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)
  imageUrl        String?        @db.VarChar(500)
  imageAlt        String?        @db.VarChar(255)
  sortOrder       Int            @default(0)
  status          CategoryStatus @default(active)
  metaTitle       String?        @db.VarChar(255)
  metaDescription String?        @db.VarChar(500)
  products        Product[]      @relation("ProductCategories")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([parentId, sortOrder])
  @@index([slug])
  @@map("categories")
}

model Product {
  id               String         @id @default(uuid())
  name             String         @db.VarChar(255)
  slug             String         @unique @db.VarChar(255)
  description      String?        @db.Text
  shortDescription String?        @db.VarChar(500)
  status           ProductStatus  @default(draft)
  hasVariants      Boolean        @default(false)
  sortOrder        Int            @default(0)
  featured         Boolean        @default(false)
  metaTitle        String?        @db.VarChar(255)
  metaDescription  String?        @db.VarChar(500)
  categories       Category[]     @relation("ProductCategories")
  images           ProductImage[]
  optionTypes      OptionType[]
  variants         Variant[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status, sortOrder])
  @@index([slug])
  @@index([featured])
  @@map("products")
}

model ProductImage {
  id        String     @id @default(uuid())
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  assetId   String
  asset     MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  altText   String?    @db.VarChar(255)
  sortOrder Int        @default(0)
  isCover   Boolean    @default(false)

  @@unique([productId, assetId])
  @@index([productId, sortOrder])
  @@map("product_images")
}

// Biblioteca central de archivos (imágenes). Un asset vive en disco y puede
// reutilizarse en varios productos y/o categorías. El archivo se elimina del
// disco solo cuando deja de estar referenciado (limpieza de huérfanos en los
// services de products/categories y al borrar desde la biblioteca).
model MediaAsset {
  id           String         @id @default(uuid())
  filename     String         @db.VarChar(255)
  originalName String?        @db.VarChar(255)
  url          String         @db.VarChar(500)
  thumbnailUrl String?        @db.VarChar(500)
  mimeType     String         @db.VarChar(100)
  sizeBytes    Int
  width        Int?
  height       Int?
  // sha256 del buffer de origen. Permite deduplicar: si se sube/descarga una
  // imagen idéntica (misma foto compartida entre productos), se reutiliza el
  // asset en vez de crear un archivo nuevo. Nullable por los assets previos.
  hash         String?        @unique @db.VarChar(64)
  createdAt    DateTime       @default(now())
  productLinks ProductImage[]
  categories   Category[]

  @@map("media_assets")
}

model OptionType {
  id        String        @id @default(uuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String        @db.VarChar(100)
  sortOrder Int           @default(0)
  values    OptionValue[]

  @@index([productId])
  @@map("option_types")
}

model OptionValue {
  id           String          @id @default(uuid())
  optionTypeId String
  optionType   OptionType      @relation(fields: [optionTypeId], references: [id], onDelete: Cascade)
  value        String          @db.VarChar(100)
  sortOrder    Int             @default(0)
  variantLinks VariantOption[]

  @@index([optionTypeId])
  @@map("option_values")
}

model Variant {
  id           String          @id @default(uuid())
  productId    String
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String?         @unique @db.VarChar(100)
  price        Decimal         @db.Decimal(10, 2)
  comparePrice Decimal?        @db.Decimal(10, 2)
  costPrice    Decimal?        @db.Decimal(10, 2)
  stock        Int             @default(0)
  stockPolicy  StockPolicy     @default(deny)
  weight       Decimal?        @db.Decimal(8, 2)
  color        String?         @db.VarChar(7)
  isDefault    Boolean         @default(false)
  sortOrder    Int             @default(0)
  active       Boolean         @default(true)
  options      VariantOption[]

  @@index([productId])
  @@index([sku])
  @@map("variants")
}

model VariantOption {
  variantId     String
  variant       Variant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValueId String
  optionValue   OptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
  @@map("variant_options")
}

// ===========================================================================
//  CARGA MASIVA (import) — historial de procesos asíncronos + incidencias.
//  Ver requerimientos/04.carga_masiva.md. Relacional (SQL), gated por isSql().
// ===========================================================================
enum ImportJobType {
  products
  categories
  images
}

enum ImportJobStatus {
  pending // creado, a la espera de que el worker lo tome
  processing // worker procesándolo
  completed // terminado sin errores
  completed_with_errors // terminado con alguna fila fallida
  failed // archivo ilegible / error global
}

enum ImportRowStatus {
  ok
  error
  skipped
}

enum ImportRowAction {
  created
  updated
  none
}

model ImportJob {
  id            String          @id @default(uuid())
  type          ImportJobType
  originalName  String          @db.VarChar(255)
  filePath      String          @db.VarChar(500)
  status        ImportJobStatus @default(pending)
  totalRows     Int             @default(0)
  processedRows Int             @default(0)
  successCount  Int             @default(0)
  errorCount    Int             @default(0)
  createdCount  Int             @default(0)
  updatedCount  Int             @default(0)
  message       String?         @db.VarChar(500)
  userId        String?
  createdAt     DateTime        @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  rows          ImportJobRow[]

  @@index([type, createdAt])
  @@map("import_jobs")
}

model ImportJobRow {
  id         String          @id @default(uuid())
  jobId      String
  job        ImportJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rowNumber  Int
  identifier String?         @db.VarChar(255)
  status     ImportRowStatus
  action     ImportRowAction @default(none)
  message    String?         @db.VarChar(500)
  rawData    Json?

  @@index([jobId, status])
  @@map("import_job_rows")
}
